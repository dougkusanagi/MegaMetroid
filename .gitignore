# Copiados do SGDK pelo makefile.gen na primeira build (versão do SGDK instalado)
src/boot/sega.s
src/boot/rom_head.c

# Artefatos de build (gerados por make -f %GDK%\makefile.gen)
out/
/build.bin
/tests/out/
*.pyc
__pycache__/
# Pranchas originais de referência: ficam só na máquina local. O resultado
# extraído para o SGDK (res/images/*-original-sgdk/) é versionado.
/res/images/original-references/
# Trilha original em MP3 (~100 MB): fica local. scripts/convert_music.py gera os WAVs versionados
# em res/sound/music/.
/res/sound/musics/
